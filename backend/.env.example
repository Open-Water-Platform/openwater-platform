# Local-dev defaults for the backend service.
# Copy this file to `.env` in the same directory (the real `.env` is
# gitignored). These credentials match the Postgres container in
# infra/docker/ and must never be reused in any non-local environment.

# Required — PostgreSQL connection URL for the asyncpg pool.
OWP_DATABASE_URL=postgresql://owp:owp@127.0.0.1:5432/owp

# Optional — uncomment to override defaults (see README.md).
# OWP_HOST=0.0.0.0
# OWP_PORT=8000
# OWP_DB_POOL_MIN_SIZE=1
# OWP_DB_POOL_MAX_SIZE=10
# OWP_DB_COMMAND_TIMEOUT=10.0
# OWP_LOG_LEVEL=INFO
# OWP_CORS_ORIGINS=http://localhost:5173
# OWP_READINGS_DEFAULT_LIMIT=100
# OWP_READINGS_MAX_LIMIT=1000
# OWP_DEVICES_DEFAULT_LIMIT=50
# OWP_DEVICES_MAX_LIMIT=200
